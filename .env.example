# Energy-to-CO2 Translation Engine Configuration
PROJECT_NAME="Energy-to-CO2 Translation Engine"
VERSION="1.0.0"
MODEL_VERSION="v1.0.0-trapezoidal-traceable"

# Storage
DATABASE_URL="sqlite:///./energy_to_co2.db"

# Integration & Carbon Policy
DEFAULT_HOST="node-alpha-01"
DEFAULT_REGION="US-EAST"
DEFAULT_PUE=1.20
MAX_GAP_SECONDS=15.0

# Telemetry Collector
ENABLE_BACKGROUND_COLLECTOR=true
BACKGROUND_SAMPLE_INTERVAL_SECONDS=2.0
SIMULATED_POWER_ENABLED=false
